# ---- Database -------------------------------------------------------------
# Option A (recommended): free Neon Postgres. Copy the "pooled" connection string.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Option B: local PostgreSQL
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brukline"
# Option C: offline SQLite file (no install, good for a low-RAM laptop)
DATABASE_URL="file:./dev.db"

# ---- Auth -----------------------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
PORT=4100
# Only needed if the frontend is served from another domain:
# CORS_ORIGIN="https://your-frontend.example.com"

# ---- Messaging --------------------------------------------------------------
# "console" logs messages to the database only (no real sending, no cost).
SMS_PROVIDER=console          # console | africastalking
WHATSAPP_PROVIDER=console     # console | twilio | meta

# Africa's Talking (SMS). Use username "sandbox" + sandbox API key to test for free.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=                 # optional, approved alphanumeric sender ID

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=         # e.g. +14155238886 (Twilio sandbox number)

# Meta WhatsApp Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v21.0

# ---- Documents ----------------------------------------------------------------
# Base address of the web app, used in "view your invoice" links sent to clients.
PUBLIC_URL="http://localhost:5273"
# Where uploaded files (shipment documents, expense receipts, logo) are stored.
# UPLOAD_DIR="./uploads"
# Max upload size in MB
MAX_UPLOAD_MB=10
